{
  "source": "ECMWF ERA5 Reanalysis",
  "native_grid_resolution_deg": 0.25,
  "temporal_resolution_hours": 1,
  "variables": {
    "sst": {
      "long_name": "Sea Surface Temperature",
      "units": "K",
      "standard_range": [290.0, 310.0],
      "physical_minimum": 271.0,
      "physical_maximum": 315.0
    },
    "vws_200_850": {
      "long_name": "Vertical Wind Shear (200 hPa - 850 hPa)",
      "units": "m/s",
      "standard_range": [2.0, 45.0],
      "physical_minimum": 0.0,
      "physical_maximum": 80.0
    },
    "rh_700": {
      "long_name": "Relative Humidity at 700 hPa",
      "units": "%",
      "standard_range": [15.0, 95.0],
      "physical_minimum": 0.0,
      "physical_maximum": 100.0
    },
    "mslp": {
      "long_name": "Mean Sea Level Pressure",
      "units": "hPa",
      "standard_range": [880.0, 1025.0],
      "physical_minimum": 850.0,
      "physical_maximum": 1050.0
    },
    "vor_850": {
      "long_name": "Relative Vorticity at 850 hPa",
      "units": "s^-1",
      "standard_range": [-0.0001, 0.0005],
      "physical_minimum": -0.002,
      "physical_maximum": 0.002
    }
  }
}
